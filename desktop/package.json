{
  "name": "concord-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Concord — cliente desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.concord.desktop",
    "productName": "Concord",
    "files": ["main.js", "config.json", "package.json"],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
