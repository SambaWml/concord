# Opcional pra rodar local: sem isso, o servidor usa SQLite num arquivo em
# server/data/concord.db automaticamente (zero conta, zero custo).
# Pra produção, cole aqui a connection string de um Postgres gratuito
# (ex: Neon.tech). Formato: postgres://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Porta em que o servidor escuta (Render define isso sozinho em produção)
PORT=5000

# Opcional: trava o CORS num domínio específico. Sem isso, aceita qualquer
# origem — ok tanto local (proxy do Vite) quanto em produção (mesma origem).
# CLIENT_ORIGIN=http://localhost:5173
